{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "homenet-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "pictures-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "homenet.app:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://127.0.0.1:8001",
      "env": {
        "HOMENET_DB": "backend/data/pictures.db",
        "HOMENET_CLOCK_START": "2026-11-05T23:45:00",
        "HOMENET_CLOCK_SPEED": "0"
      }
    },
    {
      "name": "pictures-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "dashboard",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174,
      "url": "http://127.0.0.1:5174",
      "env": {
        "HG_API": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "gif-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "homenet.app:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001,
      "url": "http://127.0.0.1:8001",
      "env": {
        "HOMENET_DB": "backend/data/gif.db",
        "HOMENET_CLOCK_START": "2026-11-05T21:11:30",
        "HOMENET_CLOCK_SPEED": "6"
      }
    }
  ]
}